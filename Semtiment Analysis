        "!pip install streamlit vaderSentiment\n",
        "\n",
        "import streamlit as st\n",
        "import pandas as pd\n",
        "from vaderSentiment.vaderSentiment import SentimentIntensityAnalyzer\n",
        "\n",
        "st.set_page_config(\n",
        "    page_title=\"Sentiment Analysis\",\n",
        "    page_icon=\"📊\",\n",
        "    layout=\"wide\"\n",
        ")\n",
        "\n",
        "st.title(\"📊 Sentiment Analysis Project\")\n",
        "st.write(\"Analyze the sentiment of any review.\")\n",
        "\n",
        "analyzer = SentimentIntensityAnalyzer()\n",
        "\n",
        "review = st.text_area(\n",
        "    \"Enter your review\",\n",
        "    placeholder=\"Example: This book is amazing!\"\n",
        ")\n",
        "\n",
        "if st.button(\"Analyze Sentiment\"):\n",
        "    if review.strip():\n",
        "        score = analyzer.polarity_scores(review)[\"compound\"]\n",
        "\n",
        "        if score >= 0.05:\n",
        "            sentiment = \"Positive 😊\"\n",
        "        elif score <= -0.05:\n",
        "            sentiment = \"Negative 😞\"\n",
        "        else:\n",
        "            sentiment = \"Neutral 😐\"\n",
        "\n",
        "        st.subheader(\"Analysis Result\")\n",
        "        st.success(f\"Sentiment: {sentiment}\")\n",
        "        st.metric(\"Sentiment Score\", round(score, 3))\n",
        "    else:\n",
        "        st.warning(\"Please enter a review first.\")\n",
        "\n",
        "st.divider()\n",
        "st.subheader(\"Project Files\")\n",
        "\n",
        "try:\n",
        "    df = pd.read_csv(\"sentiment_results.csv\")\n",
        "    st.write(\"Sample sentiment analysis results\")\n",
        "    st.dataframe(df.head(20), use_container_width=True)\n",
        "except FileNotFoundError:\n",
        "    st.info(\"Sample results file is not available.\")"
      ],
